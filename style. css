/* General Setup */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: #121212;
    color: #ffffff;
    padding: 15px;
    max-width: 600px;
    margin: 0 auto;
}

/* Header & Banner */
.header {
    text-align: center;
    margin-bottom: 25px;
}

.banner {
    background: #ffffff;
    color: #121212;
    padding: 25px 10px 45px 10px;
    border-radius: 12px 12px 0 0;
}

.banner h1 {
    font-size: 2.2rem;
    font-weight: 900;
    text-transform: uppercase;
}

.banner .tagline {
    font-weight: 600;
    color: #444;
}

/* Profile Picture Section */
.profile-container {
    position: relative;
    width: 100px;
    margin: -50px auto 10px auto;
}

.profile-pic {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    border: 4px solid #121212;
    object-fit: cover;
    background-color: #333;
    display: block;
}

.badge {
    position: absolute;
    bottom: 5px;
    right: 5px;
    background-color: #0066ff;
    color: #fff;
    font-size: 0.7rem;
    font-weight: bold;
    padding: 2px 6px;
    border-radius: 4px;
}

.designer-name {
    font-size: 1.5rem;
    margin-bottom: 12px;
}

/* Info List */
.info-list {
    list-style: none;
    font-size: 0.9rem;
    color: #b0b0b0;
    margin-bottom: 20px;
}

.info-list li {
    margin: 6px 0;
}

.info-list i {
    color: #0066ff;
    margin-right: 6px;
}

/* Action Buttons */
.action-buttons {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.btn {
    display: block;
    padding: 12px;
    border-radius: 25px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    text-align: center;
    transition: 0.3s;
}

.btn-primary {
    background-color: #ffffff;
    color: #121212;
}

.btn-secondary {
    background-color: #2a2a2a;
    color: #ffffff;
}

.btn-outline {
    border: 1px solid #333;
    color: #ffffff;
    background-color: transparent;
}

.btn:hover {
    opacity: 0.85;
}

/* Hire Card */
.hire-card {
    background-color: #1e1e1e;
    border: 1px solid #2a2a2a;
    border-radius: 12px;
    padding: 15px;
    margin-bottom: 25px;
}

.hire-card h3 {
    font-size: 1.1rem;
    margin-bottom: 15px;
    border-bottom: 1px solid #2a2a2a;
    padding-bottom: 8px;
}

.hire-option {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    color: #d1d1d1;
    text-decoration: none;
    cursor: pointer;
}

.hire-option:hover {
    color: #ffffff;
}

/* Navigation Tabs */
.tab-nav {
    display: flex;
    border-bottom: 1px solid #2a2a2a;
    margin-bottom: 20px;
}

.tab-btn {
    flex: 1;
    background: none;
    border: none;
    color: #888;
    padding: 10px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
}

.tab-btn.active {
    color: #ffffff;
    border-bottom: 2px solid #ffffff;
}

/* Tab Contents */
.tab-content {
    display: none;
}

.tab-content.active-content {
    display: block;
}

.section-title {
    font-size: 1.2rem;
    margin-bottom: 15px;
}

/* Card & Grid Styles */
.card-grid, .project-grid {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.card, .project-card {
    background-color: #1e1e1e;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid #2a2a2a;
}

.card-img-holder, .project-img {
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    color: #ffffff99;
}

.project-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    text-align: center;
    padding: 0 10px;
}

.placeholder-1 { background: linear-gradient(135deg, #2c3e50, #3498db); }
.placeholder-2 { background: linear-gradient(135deg, #4a00e0, #8e2de2); }
.placeholder-3 { background: linear-gradient(135deg, #11998e, #38ef7d); }
.placeholder-4 { background: linear-gradient(135deg, #ff416c, #ff4b2b); }

.card-body, .project-meta {
    padding: 12px;
}

.price {
    color: #0066ff;
    font-weight: bold;
    margin-top: 5px;
}

.project-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: #aaa;
}

/* Footer */
footer {
    text-align: center;
    color: #666;
    font-size: 0.8rem;
    margin-top: 30px;
    padding: 15px 0;
}
